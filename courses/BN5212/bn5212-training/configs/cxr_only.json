{
  "experiment": "cxr_only",
  "notes": "Experiment 2. Chest radiograph only, ImageNet-pretrained ViT-B/16 as in MeTra. Sized for an 8 GB GPU: micro-batch 8 x accumulation 2 = effective batch 16. On a larger card raise data.batch_size and drop grad_accumulation_steps to 1.",
  "modalities": [
    "cxr"
  ],
  "data": {
    "run_dir": "/srv/derived/bn5212/mortality_v1",
    "batch_size": 8,
    "num_workers": 4
  },
  "image_encoder": {
    "name": "timm_vit",
    "timm_model": "vit_base_patch16_224",
    "pretrained": true,
    "embed_dim": 768,
    "patch_size": 16,
    "dropout": 0.1
  },
  "fusion": {
    "name": "image_only",
    "embed_dim": 768,
    "pooling": "cls",
    "dropout": 0.1
  },
  "head": {
    "num_outputs": 1,
    "dropout": 0.1
  },
  "optim": {
    "epochs": 200,
    "lr": 5e-06,
    "weight_decay": 0.05,
    "warmup_epochs": 5,
    "min_lr": 1e-07,
    "early_stopping_patience": 20,
    "positive_class_weight": null,
    "use_sample_weight": true,
    "amp": true,
    "grad_accumulation_steps": 2
  },
  "seed": 5212,
  "selection_metric": "auroc",
  "device": "auto"
}
