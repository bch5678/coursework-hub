{
  "schema_version": "1.0",
  "dataset_versions": {"mimic_iv": "3.1", "mimic_cxr": "2.1.0"},
  "paths": {
    "mimic_iv_root": "../../data/mimiciv",
    "image_root": "../../data/mimic-cxr/2.1.0",
    "cxr_metadata": null,
    "output_dir": "../../data/runs/icu_mortality_v1"
  },
  "cohort": {
    "unit": "icu_stay", "min_age": 18, "views": ["AP", "PA"],
    "selection": "first_per_icu_stay"
  },
  "alignment": {
    "icu_observation_hours": 48,
    "max_hours_after_admission": null,
    "minimum_hours_before_end": 0
  },
  "label": {
    "kind": "in_hospital_mortality", "column": "hospital_expire_flag",
    "positive_values": ["1"], "negative_values": ["0"]
  },
  "split": {"seed": 5212, "train": 0.7, "val": 0.15, "test": 0.15, "stratify": true},
  "cleaning": {"verify_images": true, "invalid_image_policy": "drop", "max_invalid_image_fraction": 0.05},
  "loader": {
    "image_size": 224, "channels": 3, "batch_size": 16, "num_workers": 0,
    "mean": [0.485, 0.456, 0.406], "std": [0.229, 0.224, 0.225]
  },
  "audit": {"hash_images": false}
}
