{
  "experiment": "cxr_only",
  "notes": "LOCAL SYNTHETIC FIXTURE ONLY - not a benchmark result. Experiment 2 on synthetic gradient images; chance performance is the correct outcome.",
  "modalities": [
    "cxr"
  ],
  "data": {
    "run_dir": "../bn5212-data-pipeline/demo/png/processed",
    "clinical_provider": "synthetic",
    "clinical_timesteps": 12,
    "batch_size": 8
  },
  "fusion": {
    "name": "image_only",
    "embed_dim": 96,
    "pooling": "cls",
    "dropout": 0.1
  },
  "head": {
    "num_outputs": 1,
    "dropout": 0.1
  },
  "optim": {
    "epochs": 15,
    "lr": 0.001,
    "weight_decay": 0.05,
    "warmup_epochs": 1,
    "min_lr": 1e-05,
    "early_stopping_patience": 8,
    "positive_class_weight": "auto",
    "use_sample_weight": true,
    "amp": false
  },
  "seed": 5212,
  "device": "cpu",
  "selection_metric": "auroc",
  "image_encoder": {
    "name": "vit",
    "embed_dim": 96,
    "patch_size": 8,
    "depth": 2,
    "num_heads": 3,
    "dropout": 0.1
  }
}
