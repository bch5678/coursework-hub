{
  "experiment": "clinical_only",
  "notes": "LOCAL SYNTHETIC FIXTURE ONLY - not a benchmark result. Experiment 1 on synthetic clinical noise; chance performance is the correct outcome.",
  "modalities": [
    "clinical"
  ],
  "data": {
    "run_dir": "../bn5212-data-pipeline/demo/png/processed",
    "clinical_provider": "synthetic",
    "clinical_timesteps": 12,
    "batch_size": 8
  },
  "fusion": {
    "name": "clinical_only",
    "embed_dim": 96,
    "pooling": "mean",
    "dropout": 0.1
  },
  "head": {
    "num_outputs": 1,
    "dropout": 0.1
  },
  "optim": {
    "epochs": 15,
    "lr": 0.001,
    "weight_decay": 0.05,
    "warmup_epochs": 1,
    "min_lr": 1e-05,
    "early_stopping_patience": 8,
    "positive_class_weight": "auto",
    "use_sample_weight": true,
    "amp": false
  },
  "seed": 5212,
  "device": "cpu",
  "selection_metric": "auroc",
  "clinical_encoder": {
    "name": "linear_projection",
    "tokenization": "per_variable",
    "embed_dim": 96,
    "missing_indicator": true,
    "dropout": 0.1
  }
}
